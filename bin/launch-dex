#!/data/data/com.termux/files/usr/bin/bash
export DISPLAY="${DISPLAY:-:0}"

if ! adb devices | grep -q "127.0.0.1:5555.*device"; then
    adb connect 127.0.0.1:5555 2>/dev/null || true
fi

# Force Android Native System Widescreen Landscape Rotation
adb -s 127.0.0.1:5555 shell settings put system accelerometer_rotation 0 2>/dev/null || true
adb -s 127.0.0.1:5555 shell settings put system user_rotation 1 2>/dev/null || true
adb -s 127.0.0.1:5555 shell settings put global enable_freeform_support 1 2>/dev/null || true

echo "Launching Ultra-High Bandwidth 16M Bitrate 40 FPS Fullscreen DeX Desktop..."
pkill -f "DeX FPS Stats" 2>/dev/null || true
pkill -f dex-hud-overlay 2>/dev/null || true

exec scrcpy -s 127.0.0.1:5555 --render-driver=opengl --video-codec=h265 --video-bit-rate=16M --max-fps=40 --video-buffer=30 --no-audio --turn-screen-off --stay-awake --window-title="🖥️ Samsung DeX Desktop" 2>&1
