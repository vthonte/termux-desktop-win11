#!/data/data/com.termux/files/usr/bin/bash
export DISPLAY="${DISPLAY:-:1}"

if ! adb devices | grep -q "127.0.0.1:5555.*device"; then
    adb connect 127.0.0.1:5555 2>/dev/null || true
fi

adb -s 127.0.0.1:5555 shell settings put global enable_freeform_support 1 2>/dev/null || true

echo "Launching Ultra-Fast Zero-Lag Samsung DeX Virtual Desktop Mode (1280x720)..."
scrcpy -s 127.0.0.1:5555 --new-display=1280x720/140 --video-bit-rate=4M --max-fps=60 --no-audio --turn-screen-off --stay-awake --window-title="🖥️ Samsung DeX Desktop Mode (720p Fast)" 2>&1
