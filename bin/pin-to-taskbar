#!/data/data/com.termux/files/usr/bin/bash
export DISPLAY="${DISPLAY:-:1}"

if [ -z "$1" ]; then
    echo "Usage: pin-to-taskbar /path/to/app.desktop"
    exit 1
fi

DESKTOP_FILE="$1"
if [ ! -f "$DESKTOP_FILE" ]; then
    echo "Error: File $DESKTOP_FILE not found!"
    exit 1
fi

DBUS_PATH=$(ls -t /data/data/com.termux/files/usr/tmp/dbus-* 2>/dev/null | grep -v 'dbus-1' | head -n 1)
if [ -n "$DBUS_PATH" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$DBUS_PATH"
fi

# Add new launcher plugin
xfce4-panel --add=launcher "$DESKTOP_FILE" 2>/dev/null || true
sleep 1

# Re-order panel-1 plugin-ids array so all launchers stay on the left near Start Menu
PLUGINS=$(xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids 2>/dev/null | grep -v 'Value is an array')
LAUNCHERS=$(echo "$PLUGINS" | grep -v -E '^(1|5|6|7|8|10|11|12|13)$')
OTHERS=$(echo "$PLUGINS" | grep -E '^(5|6|7|8|10|11|12|13)$')

CMD="xfconf-query -c xfce4-panel -p /panels/panel-1/plugin-ids -s 1"
TYPES="-t int"

for l in $LAUNCHERS; do
    CMD="$CMD -s $l"
    TYPES="$TYPES -t int"
done

for o in $OTHERS; do
    CMD="$CMD -s $o"
    TYPES="$TYPES -t int"
done

eval "$CMD $TYPES" 2>/dev/null || true

echo "App $DESKTOP_FILE pinned to taskbar on the left!"
