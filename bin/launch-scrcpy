#!/data/data/com.termux/files/usr/bin/bash
export DISPLAY="${DISPLAY:-:1}"

if ! adb devices | grep -q "127.0.0.1:5555.*device"; then
    adb connect 127.0.0.1:5555 2>/dev/null || true
fi

echo "Launching Android Phone Screen (Samsung DeX style: Physical Screen OFF)..."
scrcpy -s 127.0.0.1:5555 --no-audio --turn-screen-off --stay-awake --window-title="📱 Android Phone Screen (DeX Mode)" 2>&1
