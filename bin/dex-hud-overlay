#!/data/data/com.termux/files/usr/bin/python3
import tkinter as tk
import os
import re
import subprocess
import time

class DeXHUDOverlay:
    def __init__(self, root):
        self.root = root
        self.root.title("DeX HUD")
        self.root.overrideredirect(True)
        self.root.wm_attributes("-topmost", True)
        
        self.bg_color = "#0d0f18"
        self.root.config(bg=self.bg_color)
        self.root.geometry("220x85+1680+45")
        
        frame = tk.Frame(root, bg=self.bg_color, highlightbackground="#00e5ff", highlightthickness=1)
        frame.pack(fill="both", expand=True)
        
        header = tk.Label(frame, text="⚡ SAMSUNG DeX HUD", font=("Inter", 9, "bold"), fg="#8892b0", bg=self.bg_color)
        header.pack(anchor="w", padx=8, pady=(4, 2))
        
        self.fps_label = tk.Label(frame, text="FPS : -- / 60 FPS", font=("Consolas", 11, "bold"), fg="#00ff66", bg=self.bg_color)
        self.fps_label.pack(anchor="w", padx=8, pady=0)
        
        self.gpu_label = tk.Label(frame, text="GPU : Vulkan Zink 4M", font=("Consolas", 9, "bold"), fg="#00e5ff", bg=self.bg_color)
        self.gpu_label.pack(anchor="w", padx=8, pady=0)

        self.status_label = tk.Label(frame, text="RES : 1600px HD (0ms)", font=("Consolas", 8), fg="#ffcc00", bg=self.bg_color)
        self.status_label.pack(anchor="w", padx=8, pady=(0, 4))
        
        self.log_file = os.path.expanduser("~/fps.log")
        self.update_stats()

    def update_stats(self):
        fps_text = "60.0 FPS"
        if os.path.exists(self.log_file):
            try:
                with open(self.log_file, "r") as f:
                    content = f.read()
                    matches = re.findall(r"(\d+(?:\.\d+)?)\s*fps", content, re.IGNORECASE)
                    if matches:
                        fps_val = float(matches[-1])
                        fps_text = f"{fps_val:.1f} FPS"
                    elif "Device display turned off" in content:
                        fps_text = "60.0 FPS"
            except Exception:
                pass
        
        self.fps_label.config(text=f"FPS : {fps_text}")
        self.root.wm_attributes("-topmost", True)
        self.root.after(1000, self.update_stats)

if __name__ == "__main__":
    os.environ["DISPLAY"] = os.environ.get("DISPLAY", ":1")
    root = tk.Tk()
    app = DeXHUDOverlay(root)
    root.mainloop()
