#!/data/data/com.termux/files/usr/bin/bash
THEME_CHOICE="${1:-win11}"
TARGET_DISP="${2:-${DISPLAY:-:0}}"

export DISPLAY="$TARGET_DISP"
export TMPDIR=/data/data/com.termux/files/usr/tmp
export XDG_RUNTIME_DIR=/data/data/com.termux/files/usr/tmp

DBUS_PATH=$(ls -t /data/data/com.termux/files/usr/tmp/dbus-* 2>/dev/null | grep -v 'dbus-1' | head -n 1)
if [ -n "$DBUS_PATH" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$DBUS_PATH"
fi

mkdir -p ~/.config/xfce4/xfconf/xfce-perchannel-xml/ ~/.config/gtk-3.0/

# Ensure Compositing is ON for Plank Dock Hover & Transparency
xfconf-query -c xfwm4 -p /general/use_compositing -s true --create -t bool 2>/dev/null || true

# Global System Font, Title, and Desktop Icon Scaling (120 DPI = 125% Large Text)
xfconf-query -c xsettings -p /Xft/DPI -s 120 --create -t int 2>/dev/null || true
xfconf-query -c xsettings -p /Gtk/FontName -s "Inter 13" --create -t string 2>/dev/null || true
xfconf-query -c xsettings -p /Gtk/MonospaceFontName -s "Cascadia Code 12" --create -t string 2>/dev/null || true
xfconf-query -c xfwm4 -p /general/title_font -s "Inter Bold 13" --create -t string 2>/dev/null || true
xfconf-query -c xfdesktop -p /desktop-icons/font-size -s 13 --create -t int 2>/dev/null || true

if [ "$THEME_CHOICE" = "macos" ] || [ "$THEME_CHOICE" = "mac" ]; then
    echo "[Theme Switcher] Applying macOS Big Sur / Sequoia Theme on $TARGET_DISP..."
    
    # 1. GTK & Icon Theme
    xfconf-query -c xsettings -p /Net/ThemeName -s "WhiteSur-Dark" --create -t string 2>/dev/null || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "WhiteSur-dark" --create -t string 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/theme -s "WhiteSur-Dark" --create -t string 2>/dev/null || true
    
    # 2. Window Control Buttons: Left-aligned macOS traffic lights CHM| (Close, Hide, Maximize)
    xfconf-query -c xfwm4 -p /general/button_layout -s "CHM|" --create -t string 2>/dev/null || true

    # 3. Wallpaper
    WALLPAPER="/data/data/com.termux/files/usr/share/backgrounds/macos-wallpaper.jpg"

    # 4. Kill Windows Taskbar Panel & Stale Docks cleanly
    pkill -9 -f xfce4-panel 2>/dev/null || true
    pkill -9 -f plank 2>/dev/null || true

    # Save current theme state
    echo "macos" > ~/.current_theme

else
    echo "[Theme Switcher] Applying Windows 11 Light Mode Theme on $TARGET_DISP..."
    
    # 1. Kill Docks cleanly
    pkill -9 -f plank 2>/dev/null || true

    # 2. GTK & Icon Theme
    xfconf-query -c xsettings -p /Net/ThemeName -s "Fluent-Light" --create -t string 2>/dev/null || true
    xfconf-query -c xsettings -p /Net/IconThemeName -s "Fluent-light" --create -t string 2>/dev/null || true
    xfconf-query -c xfwm4 -p /general/theme -s "Fluent-Light" --create -t string 2>/dev/null || true
    
    # 3. Window Control Buttons: Right-aligned Windows buttons |HMC (Hide, Maximize, Close)
    xfconf-query -c xfwm4 -p /general/button_layout -s "|HMC" --create -t string 2>/dev/null || true

    # 4. Wallpaper
    WALLPAPER="/data/data/com.termux/files/usr/share/backgrounds/windows11-light.jpg"

    # 5. Start Menu Logo & Title
    LOGO_PATH="/data/data/com.termux/files/usr/share/icons/windows-logo.png"
    if [ -f "$LOGO_PATH" ]; then
        xfconf-query -c xfce4-panel -p /plugins/plugin-1/button-icon -s "$LOGO_PATH" --create -t string 2>/dev/null || true
        xfconf-query -c xfce4-panel -p /plugins/plugin-1/button-title -s "Start" --create -t string 2>/dev/null || true
    fi

    # 6. Reset Windows 11 Taskbar Panel (Full Width 100%, 38px height, bottom position)
    xfconf-query -c xfce4-panel -p /panels/panel-1/position -s "p=6;x=0;y=1080" --create -t string 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /panels/panel-1/size -s 38 --create -t int 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /panels/panel-1/length -s 100 --create -t int 2>/dev/null || true
    xfconf-query -c xfce4-panel -p /panels/panel-1/autohide-behavior -s 0 --create -t int 2>/dev/null || true

    # Relaunch Windows Taskbar if missing
    if ! pgrep -f xfce4-panel >/dev/null 2>&1; then
        xfce4-panel >/dev/null 2>&1 &
    else
        xfce4-panel -r >/dev/null 2>&1 &
    fi

    # Save current theme state
    echo "win11" > ~/.current_theme
fi

# Set Wallpaper
if [ -f "$WALLPAPER" ]; then
    DESKTOP_PROPS=$(xfconf-query -c xfdesktop -l 2>/dev/null | grep last-image | head -n 5)
    for prop in $DESKTOP_PROPS; do
        xfconf-query -c xfdesktop -p "$prop" -s "$WALLPAPER" 2>/dev/null || true
    done
fi

# Force XFCE Settings & Window Manager to reload themes live
xfsettingsd --replace >/dev/null 2>&1 &
xfwm4 --replace >/dev/null 2>&1 &

# Wait for Window Manager frame redraw to complete
sleep 1.5

# If macOS Mode, launch Plank Dock FRESH
if [ "$THEME_CHOICE" = "macos" ] || [ "$THEME_CHOICE" = "mac" ]; then
    plank >/dev/null 2>&1 &
fi

echo "Theme [$THEME_CHOICE] applied successfully on $TARGET_DISP!"
